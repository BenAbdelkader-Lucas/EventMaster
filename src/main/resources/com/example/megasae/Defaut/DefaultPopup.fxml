<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Popups.PopupController">
    <children>

        <AnchorPane prefHeight="45.0" style="-fx-background-color: #0D1B4B;">
            <children>
                <Label fx:id="lblFormTitre" alignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Ajout de élément / Brouillon" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <GridPane hgap="10.0" style="-fx-padding: 30 40 20 40;" vgap="15.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" minWidth="120.0" prefWidth="140.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            </columnConstraints>

            <children>
                <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Noms :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNom" promptText="Entrez le nom" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Dates :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <DatePicker fx:id="dateDebut" maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Chiffres :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Spinner fx:id="spinQuantite" editable="true" maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Sélection (Tag/Rôle) :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <children>
                        <Button fx:id="btnAjouterOption" onAction="#handleOpenPopupAction" prefWidth="30.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-cursor: hand; -fx-font-weight: bold;" text="+" />
                        <ComboBox fx:id="comboOptions" maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Note / Description :" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.valignment="TOP" />
                <TextArea fx:id="txtDescription" prefHeight="80.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <HBox alignment="CENTER" spacing="40.0" style="-fx-padding: 0 40 30 40;">
            <children>
                <Button fx:id="btnAnnuler" onAction="#handleAnnulerAction" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #D24A5B; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="ANNULER" />

                <Button fx:id="btnConfirmer" onAction="#handleConfirmerAction" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #2980B9; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Confirmer" />
            </children>
        </HBox>

    </children>
</VBox>
