<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="350.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;" stylesheets="@../../../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Popups.Popup_FiltresController">
    <children>
        <AnchorPane prefHeight="35.0" style="-fx-background-color: #0D1B4B;">
            <children>
                <Label alignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" text="Choix de filtre" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <VBox spacing="15.0" style="-fx-padding: 20;">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-size: 12; -fx-text-fill: #555555;" text="Actif(s)" />
                        <FlowPane fx:id="flowFiltresActifs" hgap="8.0" vgap="8.0">
                            <children>
                                <Button fx:id="btnRemoveFiltre1" onAction="#handleRemoveFiltreAction" style="-fx-background-color: #A68B7C; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 11; -fx-padding: 3 10; -fx-cursor: hand;" text="Accès scène  ✖" />
                            </children>
                        </FlowPane>
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <HBox fx:id="btnToggleStatut" alignment="CENTER_LEFT" onMouseClicked="#handleToggleStatutAction" spacing="5.0" style="-fx-cursor: hand;">
                            <children>
                                <Label fx:id="lblArrowStatut" style="-fx-font-weight: bold; -fx-font-size: 13;" text="ᐱ" />
                                <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Statut" />
                            </children>
                        </HBox>

                        <FlowPane fx:id="paneStatutFiltres" hgap="10.0" style="-fx-padding: 0 0 0 10;" vgap="10.0">
                            <children>
                                <Button fx:id="btnFiltreEnCours" onAction="#handleAddFiltreAction" prefWidth="85.0" style="-fx-background-color: #EBF5FB; -fx-border-color: #3498DB; -fx-text-fill: #3498DB; -fx-border-radius: 15; -fx-background-radius: 15; -fx-font-size: 11; -fx-cursor: hand;" text="En cours" />
                            </children>
                        </FlowPane>
                    </children>
                </VBox>

                <HBox fx:id="btnToggleCapacite" alignment="CENTER_LEFT" onMouseClicked="#handleToggleCapaciteAction" spacing="5.0" style="-fx-cursor: hand;">
                    <children>
                        <Label fx:id="lblArrowCapacite" style="-fx-font-weight: bold; -fx-font-size: 13;" text="ᐯ" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Capacité" />
                    </children>
                </HBox>

                <HBox fx:id="btnToggleTags" alignment="CENTER_LEFT" onMouseClicked="#handleToggleTagsAction" spacing="5.0" style="-fx-cursor: hand;">
                    <children>
                        <Label fx:id="lblArrowTags" style="-fx-font-weight: bold; -fx-font-size: 13;" text="ᐯ" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Tags" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
