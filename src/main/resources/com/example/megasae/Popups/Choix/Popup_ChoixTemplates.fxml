<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="450.0" prefWidth="500.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6;" stylesheets="@../../../../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Popups.Choix.Popup_ChoixTemplatesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Sélectionner un modèle d'événement" textFill="#1E293B">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <TableView fx:id="tableTemplates" style="-fx-background-radius: 4; -fx-border-color: #E2E8F0;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="255.1999671459198" text="Nom du modèle" />
                <TableColumn fx:id="colActions" minWidth="0.0" prefWidth="198.40003967285156" style="-fx-alignment: CENTER;" text="Actions" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>

                <Button fx:id="btnImporter" mnemonicParsing="false" onAction="#handleImporterAction" text="Importer">
                    <padding>
                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                    </padding>
                </Button>

                <Button fx:id="btnCreerTemplate" mnemonicParsing="false" onAction="#handleCreerTemplateAction" text="Nouveau template">
                    <padding>
                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                    </padding>
                </Button>

                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAnnuler" mnemonicParsing="false" onAction="#handleAnnulerAction" text="Annuler">
                    <font>
                        <Font size="13.0" />
                    </font>
                    <padding>
                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
