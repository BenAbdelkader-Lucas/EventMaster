<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="500.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6;" stylesheets="@../../../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Popups.Popup_EvenementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

    <Label fx:id="lblTitreFormulaire" text="Formulaire Événement" textFill="#1E293B">
        <font>
            <Font name="System Bold" size="16.0" />
        </font>
    </Label>

    <VBox fx:id="boxChampsTemplate" spacing="12.0">
        <children>
            <VBox spacing="4.0">
                <children>
                    <Label text="Nom du modèle (*)" textFill="#475569" />
                    <TextField fx:id="txtNomTemplate" style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
                </children>
            </VBox>
            <VBox spacing="4.0">
                <children>
                    <Label text="Description du modèle :" textFill="#475569" />
                    <TextArea fx:id="txtDescTemplate" prefHeight="60.0" style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" wrapText="true" />
                </children>
            </VBox>
        </children>
    </VBox>

    <VBox spacing="12.0">
        <children>
            <VBox spacing="4.0">
                <children>
                    <Label text="Nom de l'événement (*)" textFill="#475569" />
                    <TextField fx:id="txtNomEvenement" style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
                </children>
            </VBox>

            <HBox spacing="15.0">
                <children>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Date de début (*)" textFill="#475569" />
                            <DatePicker fx:id="pickerDateDebut" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 4;" />
                        </children>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Date de fin" textFill="#475569" />
                            <DatePicker fx:id="pickerDateFin" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 4;" />
                        </children>
                    </VBox>
                </children>
            </HBox>

            <HBox spacing="15.0">
                <children>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Capacité max" textFill="#475569" />
                            <TextField fx:id="txtCapacite" promptText="Ex: 150" style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
                        </children>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Budget (€)" textFill="#475569" />
                            <TextField fx:id="txtBudget" promptText="Ex: 2500.00" style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
                        </children>
                    </VBox>
                    <VBox spacing="4.0">
                        <children>
                            <Label text="Couleur" textFill="#475569" />
                            <ColorPicker fx:id="pickerCouleur" style="-fx-background-radius: 4; -fx-cursor: hand;" />
                        </children>
                    </VBox>
                </children>
            </HBox>

            <VBox spacing="4.0">
                <children>
                    <Label text="Description globale :" textFill="#475569" />
                    <TextArea fx:id="txtDescription" prefHeight="80.0" style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" wrapText="true" />
                </children>
            </VBox>
        </children>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <children>
            <Button fx:id="btnAnnuler" mnemonicParsing="false" onAction="#handleAnnulerAction" text="Annuler">
                <padding>
                    <Insets bottom="6.0" left="14.0" right="14.0" top="6.0" />
                </padding>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnEnregistrer" mnemonicParsing="false" onAction="#handleEnregistrerAction" text="Enregistrer">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
                <padding>
                    <Insets bottom="6.0" left="14.0" right="14.0" top="6.0" />
                </padding>
            </Button>
        </children>
    </HBox>

    </children>
</VBox>
