<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;" stylesheets="@../../../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Popups.Popup_StatutController">
    <children>

        <AnchorPane prefHeight="35.0" style="-fx-background-color: #0D1B4B;">
            <children>
                <Label alignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" text="Choix de statut" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <VBox spacing="10.0" style="-fx-padding: 15;">
            <children>
                <Button fx:id="btnStatutEnCours" maxWidth="1.7976931348623157E308" onAction="#handleSelectStatutAction" style="-fx-background-color: #2980B9; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11;" text="En cours" />
                <Button fx:id="btnStatutBrouillon" maxWidth="1.7976931348623157E308" onAction="#handleSelectStatutAction" style="-fx-background-color: #FF4D00; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11;" text="Brouillon" />
                <Button fx:id="btnStatutArchive" maxWidth="1.7976931348623157E308" onAction="#handleSelectStatutAction" style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11;" text="Archivé" />
                <Button fx:id="btnStatutPublie" maxWidth="1.7976931348623157E308" onAction="#handleSelectStatutAction" style="-fx-background-color: #1ABC9C; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11;" text="Publié" />
                <Button fx:id="btnStatutCloture" maxWidth="1.7976931348623157E308" onAction="#handleSelectStatutAction" style="-fx-background-color: #7F8C8D; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11;" text="Clôturé" />
                <Button fx:id="btnStatutAnnule" maxWidth="1.7976931348623157E308" onAction="#handleSelectStatutAction" style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11;" text="Annulé" />
            </children>
        </VBox>

    </children>
</VBox>
