<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="500.0" spacing="0.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D3D3D3; -fx-border-width: 1;" stylesheets="@../../../../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Popups.Ajout.Popup_AjoutTacheController">
    <children>

        <HBox alignment="CENTER" style="-fx-background-color: #0A0944;" VBox.vgrow="NEVER">
            <children>
                <Label fx:id="lblTitreFormulaire" text="Ajout de : Tache" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="12.0" top="12.0" />
            </padding>
        </HBox>

        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="100.0" text="Nom* :" textFill="#2C3E50">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtNomTache" style="-fx-background-color: #FFFFFF; -fx-border-color: #BDC3C7; -fx-border-radius: 3;" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="100.0" text="Tags :" textFill="#2C3E50">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <HBox style="-fx-border-color: #BDC3C7; -fx-border-radius: 3;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Button fx:id="btnAjouterTag" mnemonicParsing="false" onAction="#handleOpenPopupTagAction" text="+" />
                                        <TextField fx:id="txtTagsTache" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="100.0" text="Date :" textFill="#2C3E50">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                  <DatePicker fx:id="datePicker" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="100.0" text="Importance* :" textFill="#2C3E50">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                  <ComboBox fx:id="comboBoxImportance" prefWidth="150.0" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" />
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="40.0">
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="10.0" />
            </padding>
            <children>
                <Button fx:id="btnAnnuler" mnemonicParsing="false" onAction="#handleAnnulerTache" prefHeight="45.0" prefWidth="160.0" text="ANNULER" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>
                <Button fx:id="btnConfirmer" mnemonicParsing="false" onAction="#handleConfirmerTache" prefHeight="45.0" prefWidth="160.0" text="Confirmer" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
