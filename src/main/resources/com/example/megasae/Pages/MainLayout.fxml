<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../../../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.megasae.controller.Pages.PageController">

    <!-- =========================================== -->
    <!-- ============    MENU GAUCHE    ============ -->
    <!-- =========================================== -->

    <left>
        <VBox fx:id="sidebar" alignment="TOP_CENTER" minWidth="250.0" prefWidth="250.0" spacing="15"
              style="-fx-background-color: #0D1B4B; -fx-padding: 75 15 25 15;">
            <Label fx:id="labelVueGenerale" alignment="CENTER" prefHeight="42.0" prefWidth="210.0"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 5 0 10 0;"
                   text="Vue générale" textAlignment="CENTER"/>

            <Button fx:id="btnTableauDeBord" onAction="#handleTableauDeBordAction"
                    onMouseEntered="#handleSidebarBtnHovered" onMouseExited="#handleSidebarBtnExited" prefWidth="210"
                    style="-fx-background-color: white; -fx-text-fill: #0D1B4B; -fx-font-size: 16; -fx-background-radius: 25; -fx-padding: 10 15; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"
                    text="Tableau de bord">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/TableauDeBord.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnListeEvenements" maxWidth="210.0" minWidth="210.0" onAction="#handleListeEvenementsAction"
                    onMouseEntered="#handleSidebarBtnHovered" onMouseExited="#handleSidebarBtnExited" prefWidth="210.0"
                    style="-fx-background-color: white; -fx-text-fill: #0D1B4B; -fx-font-size: 16; -fx-background-radius: 25; -fx-padding: 10 15; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"
                    text="Événements">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/ListeEvenements.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <VBox fx:id="sousMenuEvenement" alignment="TOP_CENTER" spacing="15">
                <Separator prefWidth="210"/>
                <Label fx:id="labelVueEvenement" alignment="CENTER" prefHeight="42.0" prefWidth="210.0"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 5 0 10 0;"
                       text="Événement sélectionné" textAlignment="CENTER"/>

                <Button fx:id="btnInformationsEvenement" onAction="#handleEvenementAction"
                        onMouseEntered="#handleSidebarBtnHovered" onMouseExited="#handleSidebarBtnExited"
                        prefWidth="210"
                        style="-fx-background-color: white; -fx-text-fill: #0D1B4B; -fx-font-size: 16; -fx-background-radius: 25; -fx-padding: 10 15; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"
                        text="Informations">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/InformationsEvenement.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="btnParticipantsEvenement" onAction="#handleParticipantsAction"
                        onMouseEntered="#handleSidebarBtnHovered" onMouseExited="#handleSidebarBtnExited"
                        prefWidth="210"
                        style="-fx-background-color: white; -fx-text-fill: #0D1B4B; -fx-font-size: 16; -fx-background-radius: 25; -fx-padding: 10 15; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"
                        text="Participants">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/ParticipantsEvenement.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="btnTachesEvenement" onAction="#handleTachesAction"
                        onMouseEntered="#handleSidebarBtnHovered" onMouseExited="#handleSidebarBtnExited"
                        prefWidth="210"
                        style="-fx-background-color: white; -fx-text-fill: #0D1B4B; -fx-font-size: 16; -fx-background-radius: 25; -fx-padding: 10 15; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"
                        text="Tâches">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/TachesEvenement.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="btnFinancesEvenement" onAction="#handleFinancesAction"
                        onMouseEntered="#handleSidebarBtnHovered" onMouseExited="#handleSidebarBtnExited"
                        prefWidth="210"
                        style="-fx-background-color: white; -fx-text-fill: #0D1B4B; -fx-font-size: 16; -fx-background-radius: 25; -fx-padding: 10 15; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"
                        text="Finances">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/FinancesEvenement.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>
            <Region nodeOrientation="LEFT_TO_RIGHT" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS"/>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/logoEventMaster.png"/>
                </image>
            </ImageView>
        </VBox>
    </left>

    <!-- =========================================== -->
    <!-- ============    MENU HAUT    ============ -->
    <!-- =========================================== -->

    <center>
        <BorderPane>
            <top>
                <StackPane maxHeight="75.0" minHeight="75.0" prefHeight="75.0">
                    <children>

                        <AnchorPane fx:id="topSpace1" maxHeight="75.0" minHeight="75.0" prefHeight="75.0"
                                    style="-fx-background-color: #f4f4f4; -fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 20 0 20;"
                                      AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <children>
                                        <Button maxWidth="210.0" minWidth="210.0"
                                                onAction="#handleAjouterEvenementAction" prefHeight="50.0"
                                                prefWidth="210.0"
                                                style="-fx-background-color: #0D1B4B; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12 20; -fx-cursor: hand;"
                                                text="+ Événement"/>
                                    </children>
                                </HBox>
                            </children>
                        </AnchorPane>

                        <AnchorPane fx:id="topSpace2" maxHeight="75.0" minHeight="75.0" prefHeight="75.0"
                                    style="-fx-background-color: #f4f4f4; -fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 5 20 5 20;"
                                      AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <children>
                                        <VBox alignment="CENTER_LEFT" spacing="5.0">
                                            <children>
                                                <Label style="-fx-font-size: 13; -fx-text-fill: #333333;"
                                                       text="Événement actif :"/>
                                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT"
                                                              style="-fx-background-color: white; -fx-border-color: #b0bec5; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                                                            <children>
                                                                <Label fx:id="lblNomEvenementActif" prefHeight="36.0"
                                                                       style="-fx-font-size: 14; -fx-padding: 0 15 0 15; -fx-text-fill: #333333;"
                                                                       text=""/>
                                                            </children>
                                                        </HBox>
                                                        <Button fx:id="btnEditerEvenementActif"
                                                                onAction="#handleEditerEvenementActifAction"
                                                                prefHeight="38.0" prefWidth="120.0"
                                                                style="-fx-background-color: #0D1B4B; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;"
                                                                text="Editer"/>
                                                        <Button fx:id="btnExporterEvenementActif"
                                                                onAction="#handleExporterEvenementActifAction"
                                                                prefHeight="38.0" prefWidth="120.0"
                                                                style="-fx-background-color: #0D1B4B; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;"
                                                                text="Exporter"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                            </children>
                        </AnchorPane>

                    </children>
                </StackPane>
            </top>

            <center>
                <StackPane fx:id="mainBoundary"/>
            </center>
        </BorderPane>
    </center>

</BorderPane>
