<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1200" stylesheets="@../../../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Pages.Page_ParticipantsEvenementController">
    <center>
        <VBox>
            <children>
                <ScrollPane fx:id="mainScrollPane" fitToHeight="true" fitToWidth="true" style="-fx-background: white; -fx-background-color: white;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="mainContent" spacing="20" style="-fx-background-color: white; -fx-padding: 30 35 30 35;">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text="Membres" textFill="#1e293b" />
                                    <HBox alignment="CENTER_RIGHT" spacing="15.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Button fx:id="btnImporterMembre" mnemonicParsing="false" onAction="#handleImporterMembre" style="-fx-background-color: #0b0947; -fx-text-fill: white; -fx-background-radius: 4px; -fx-padding: 10 15 10 15;" text="+ Importer membre" />
                                            <Button fx:id="btnNouveauMembre" mnemonicParsing="false" onAction="#handleNouveauMembre" style="-fx-background-color: #0b0947; -fx-text-fill: white; -fx-background-radius: 4px; -fx-padding: 10 15 10 15;" text="+ Nouveau membre" />
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <children>
                                    <TextField fx:id="txtRecherche" onKeyReleased="#handleRecherche" prefWidth="220.0" promptText="Rechercher un participant" style="-fx-background-radius: 15px; -fx-border-color: #cbd5e1; -fx-border-radius: 15px; -fx-background-color: transparent; -fx-padding: 5 15 5 15;" />
                                    <Button fx:id="btnFiltrer" mnemonicParsing="false" onAction="#handleFiltrer" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 4px; -fx-padding: 5 20 5 20;" text="Filtrer" textFill="#1e293b" />
                                </children>
                            </HBox>

                            <TableView fx:id="tableMembres" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1;" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colMembre" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Membre" />
                                    <TableColumn fx:id="colEmail" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Email" />
                                    <TableColumn fx:id="colRole" prefWidth="203.0" style="-fx-alignment: CENTER;" text="Rôle(s)" />
                                    <TableColumn fx:id="colTags" prefWidth="203.0" style="-fx-alignment: CENTER;" text="Tag(s)" />
                                    <TableColumn fx:id="colPresence" prefWidth="323.0" style="-fx-alignment: CENTER;" text="Présence" />
                                    <TableColumn fx:id="colActions" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Actions" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
