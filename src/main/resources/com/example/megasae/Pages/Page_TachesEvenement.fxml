<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1200" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.megasae.controller.Pages.Page_TachesEvenementController">
    <center>
        <VBox>
            <children>
                <ScrollPane fx:id="mainScrollPane" fitToHeight="true" fitToWidth="true" style="-fx-background: white; -fx-background-color: white;" VBox.vgrow="ALWAYS">
                    <content>

                        <VBox fx:id="mainContent" spacing="20" style="-fx-background-color: white; -fx-padding: 30 35 30 35;">

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Tâches et Notes" textFill="#1e293b" />
                                    <HBox alignment="CENTER_RIGHT" spacing="15.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Button fx:id="btnNouvelleNote" onAction="#handleNouvelleNoteAction" style="-fx-background-color: #0b0947; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 15; -fx-cursor: hand;" text="+ Nouvelle note" />
                                            <Button fx:id="btnNouvelleTache" onAction="#handleNouvelleTacheAction" style="-fx-background-color: #0b0947; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 15; -fx-cursor: hand;" text="+ Nouvelle tâche" />
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>

                            <HBox spacing="15.0">
                                <children>
                                    <TextField fx:id="txtRechercheTache" onKeyReleased="#handleRecherche" prefWidth="300.0" promptText="Rechercher une tâche..." style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-background-color: white; -fx-padding: 6 12;" />
                                    <Button fx:id="btnFiltrer" onAction="#handleFiltrerAction" prefWidth="100.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-cursor: hand;" text="Filtrer" />
                                </children>
                            </HBox>

                            <VBox spacing="10.0">
                                <children>
                                    <Label style="-fx-font-weight: bold;" text="En cours" textFill="#64748b" />
                                    <VBox fx:id="containerEnCours" spacing="10.0">
                                    </VBox>
                                </children>
                            </VBox>

                            <VBox spacing="10.0">
                                <children>
                                    <Label style="-fx-font-weight: bold;" text="Avancement" textFill="#64748b" />
                                    <StackPane alignment="CENTER_LEFT">
                                        <children>
                                            <ProgressBar fx:id="progressTaches" prefHeight="30.0" prefWidth="2000.0" progress="0.0" style="-fx-accent: #319ebc;" />
                                            <Label fx:id="lblProgressText" text="0% Fait" textFill="white">
                                                <StackPane.margin>
                                                    <Insets left="15.0" />
                                                </StackPane.margin>
                                            </Label>
                                        </children>
                                    </StackPane>
                                </children>
                            </VBox>

                            <VBox spacing="10.0">
                                <children>
                                    <Label style="-fx-font-weight: bold;" text="Archivé" textFill="#64748b" />
                                    <VBox fx:id="containerArchive" spacing="10.0">
                                    </VBox>
                                </children>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
